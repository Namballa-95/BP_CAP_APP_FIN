{
    "welcomeFile": "/supplier-registration/index.html",
    "authenticationMethod": "route",
    "routes": [
        {
            "source": "^/supplier-registration/(.*)$",
            "target": "$1",
            "localDir": "./webapp",
            "authenticationType": "xsuaa"
        }, 
        {
            "source": "^/bp/(.*)$",
            "target": "/bp/$1",
            "destination": "srv-api",
            "authenticationType": "xsuaa"
        }
    ]
}
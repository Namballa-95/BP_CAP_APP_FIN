### =====================================================
### SUPPLIER BP CAP - CRUD TESTING
### =====================================================


### =====================================================
### 1. GET ALL SUPPLIERS
### =====================================================

GET http://localhost:4004/bp/Suppliers
Accept: application/json


### =====================================================
### 2. GET SUPPLIER BY ID
### =====================================================

GET http://localhost:4004/bp/Suppliers?$filter=SupplierID%20eq%20'SUP001'
Accept: application/json


### =====================================================
### 3. CREATE SUPPLIER
### =====================================================

POST http://localhost:4004/bp/Suppliers
Content-Type: application/json

{
    "SupplierID": "SUP004",
    "SupplierName": "Arcelor Mittal Global tech",
    "SupplierEmail": "arcelor@gmail.com"
}


### =====================================================
### 4. GET SINGLE SUPPLIER USING UUID
### =====================================================

GET http://localhost:4004/bp/Suppliers(397331e8-08d1-4e46-b3e1-fdaa45b3ff1a)
Accept: application/json


### =====================================================
### 5. UPDATE SUPPLIER USING PATCH
### =====================================================

PATCH http://localhost:4004/bp/Suppliers(397331e8-08d1-4e46-b3e1-fdaa45b3ff1a)
Content-Type: application/json

{
    "SupplierName": "ABC Industries Updated",
    "SupplierEmail": "abc.updated@gmail.com"
}


### =====================================================
### 6. DELETE SUPPLIER
### =====================================================

DELETE http://localhost:4004/bp/Suppliers(8e0515da-72dc-42b7-819c-8ef4cf51bff1)


### =====================================================
### 7. CHECK DELETED SUPPLIER
### =====================================================

GET http://localhost:4004/bp/Suppliers(f925a97a-87ed-4335-a414-bbd9e05b20e5)
Accept: application/json

//================================================================================================================================================================
### VALIDATE REGISTERED SUPPLIER
GET http://localhost:4004/bp/validateSupplier(SupplierID='SUP001',SupplierEmail='xyz@gmail.com')
Accept: application/json
### VALIDATE UNREGISTERED SUPPLIER

GET http://localhost:4004/bp/validateSupplier(SupplierID='SUP999',SupplierEmail='unknown@gmail.com')
Accept: application/json

//=========================================================================================================================================================================================================

